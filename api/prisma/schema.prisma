generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id Int @id @default(autoincrement())
  name String @unique
  email String @unique
  password String
  ssn String @unique
  birthday DateTime
  gender String 
  isActive Boolean
  isAdmin Boolean
}

enum Genero {
  Masculino
  Feminino
  Não_Binário
  Outro
}

enum StatusCliente {
  Ativo
  Inativo
}
